<Defs>

	<!-- 거인 충각 -->
    <ThingDef ParentName="GiantBaseMelee_Quality">
		<defName>GI_Drill</defName>
		<label>giant drill</label>
		<techLevel>Spacer</techLevel>
		<description>A giant hand drill designed exclusively for giants. Shields attached for use in combat effectively prevent attacks.</description>
		<graphicData>
			<texPath>Giant/Weapons/Spacer/GI_Drill</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>3.0</drawSize>
		</graphicData>
		<uiIconScale>0.62</uiIconScale>
		<costList>
			 <Uranium>240</Uranium>
			 <Plasteel>260</Plasteel>
			 <ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		<weaponTags>
			<li>Giant_Melee</li>
		</weaponTags>
		<statBases>
			<WorkToMake>106000</WorkToMake>
			<Mass>38</Mass>
			<MaxHitPoints>600</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<EquipDelay>8</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.2</MoveSpeed>
			<IncomingDamageFactor>-0.15</IncomingDamageFactor>
			<MiningSpeed>0.25</MiningSpeed>
			<MiningYield>0.1</MiningYield>
		</equippedStatOffsets>
		<equippedAngleOffset>-50</equippedAngleOffset>
		<burnableByRecipe>true</burnableByRecipe>
		<tools>
			<li>
				<label>drill bit</label>
				<labelUsedInLogging>false</labelUsedInLogging>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>12</power>
				<armorPenetration>0.95</armorPenetration>
				<cooldownTime>0.2</cooldownTime>
				<extraMeleeDamages>
                    <li>
                        <def>EMP</def>
                        <amount>9</amount>
                    </li>
                </extraMeleeDamages>
			</li>
		</tools>
		<recipeMaker>
			<researchPrerequisite>DeepDrilling</researchPrerequisite>
			<recipeUsers>
				<li>FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
			    <Crafting>12</Crafting>
			</skillRequirements>
		</recipeMaker>
	</ThingDef>

	<ThingDef ParentName="GiantBaseRange">
		<defName>GI_GiantAutocannon</defName>
		<label>giant Autocannon</label>
		<description>A giant cannon built exclusively for giants. Smaller races modified heavy automatic turrets to create it. It takes a long time to fire, has terrible accuracy, and is quite cumbersome, but once it starts shooting, it can destroy anything.</description>
		<graphicData>
			<texPath>Giant/Weapons/Spacer/GI_Drill</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>3.0</drawSize>
		</graphicData>
		<uiIconScale>0.62</uiIconScale>
		<costList>
			<Steel>350</Steel>
			<Plasteel>300</Plasteel>
			<Uranium>120</Uranium>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
		<Mass>36</Mass>
		<WorkToMake>108000</WorkToMake>
		<AccuracyTouch>0.10</AccuracyTouch>
		<AccuracyShort>0.15</AccuracyShort>
		<AccuracyMedium>0.15</AccuracyMedium>
		<AccuracyLong>0.5</AccuracyLong>
		<RangedWeapon_Cooldown>10</RangedWeapon_Cooldown>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.8</MoveSpeed>
		</equippedStatOffsets>

		<equippedAngleOffset>45</equippedAngleOffset>
		

		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_AutocannonTurret</defaultProjectile>
				<warmupTime>0.24</warmupTime>
				<minRange>3</minRange>
				<range>30</range>
				<soundCast>Shot_Autocannon</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>12</muzzleFlashScale>
			</li>
		</verbs>
		<weaponTags>
			<li>Giant_Ranged</li>
		</weaponTags>

		<tools>
			<li>
				<label>cannon stock</label>
				<capacities>
				<li>Blunt</li>
				</capacities>
				<power>17</power>
				<cooldownTime>2.2</cooldownTime>
			</li>
			<li>
				<label>cannon barrel</label>
				<capacities>
				<li>Blunt</li>
				<li>Poke</li>
				</capacities>
				<power>25</power>
				<cooldownTime>2.8</cooldownTime>
			</li>
		</tools>
		<recipeMaker>
			<researchPrerequisite>HeavyTurrets</researchPrerequisite>
			<recipeUsers>
				<li>FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
			    <Crafting>12</Crafting>
			</skillRequirements>
		</recipeMaker>
	</ThingDef>

</Defs>