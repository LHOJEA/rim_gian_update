<?xml version="1.0" encoding="utf-8" ?>
<Patch>
<!-- 유전자로 구현된 만큼 1로 바꿔줄 것들. -->
<!-- AlienRace.ThingDef_AlienRace의 statBases의 IncomingDamageFactor 0.8. Robust유전자로 대체.-->
<!-- AlienRace.ThingDef_AlienRace의 statBases의 ImmunityGainSpeed 1.3 Immunity_SuperStrong 유전자로 대체. 의료 능력은 떨어지지만 회복력이 좋은 컨셉.-->
<!-- AlienRace.ThingDef_AlienRace의 statBases의 NegotiationAbility 0.2 AptitudePoor_Social 유전자로 대체.-->
<!-- AlienRace.ThingDef_AlienRace의 statBases의 MedicalTendQuality 0.4 AptitudePoor_Medical 유전자로 대체.-->
<!-- AlienRace.ThingDef_AlienRace의 statBases의 ResearchSpeed 0.1 AptitudeTerrible_Intellectual 유전자로 대체.-->
    <Operation Class = "PatchOperationSequence">
        <operations>
            <li Class="PatchOperationReplace" MayRequire = "Ludeon.Rimworld.Biotech">
                <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "HC_Giant"]/statBases/IncomingDamageFactor</xpath>
                <value>
                    <IncomingDamageFactor>1</IncomingDamageFactor>
                </value>
            </li>
            <li Class="PatchOperationReplace" MayRequire = "Ludeon.Rimworld.Biotech">
                <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "HC_Giant"]/statBases/ImmunityGainSpeed</xpath>
                <value>
                    <ImmunityGainSpeed>1</ImmunityGainSpeed>
                </value>
            </li>
            <li Class="PatchOperationReplace" MayRequire = "Ludeon.Rimworld.Biotech">
                <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "HC_Giant"]/statBases/NegotiationAbility</xpath>
                <value>
                    <NegotiationAbility>1</NegotiationAbility>
                </value>
            </li>
            <li Class="PatchOperationReplace" MayRequire = "Ludeon.Rimworld.Biotech">
                <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "HC_Giant"]/statBases/MedicalTendQuality</xpath>
                <value>
                    <MedicalTendQuality>1</MedicalTendQuality>
                </value>
            </li>
            <li Class="PatchOperationReplace" MayRequire = "Ludeon.Rimworld.Biotech">
                <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "HC_Giant"]/statBases/ResearchSpeed</xpath>
                <value>
                    <ResearchSpeed>1</ResearchSpeed>
                </value>
            </li>
        </operations>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
			<li>Biotech</li>
		</mods>
        <match Class="PatchOperationReplace">
            <xpath>/Defs/ScenarioDef[defName = "GI_Scenario"]/scenario/parts</xpath>
            <value>
                <parts>
                    <!-- Config pages -->
                    <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
                        <def>ConfigurePawnsXenotypes</def>
                        <pawnChoiceCount>8</pawnChoiceCount>
                        <overrideKinds>
                            <li>
                                <xenotype>GianthcXenotype</xenotype>
                                <pawnKind>GI_Tribal</pawnKind>
                            </li>
                        </overrideKinds>
                        <xenotypeCounts>
                        <li>
                            <xenotype>GianthcXenotype</xenotype>
                            <count>3</count>
                            <description>Giant</description>
                            <requiredAtStart>true</requiredAtStart>
                            <allowedDevelopmentalStages>Adult, Child</allowedDevelopmentalStages>
                        </li>
                        </xenotypeCounts>
                    </li>

                    <!-- Player starting stuff spawn method-->
                    <li Class="ScenPart_PlayerPawnsArriveMethod">
                        <def>PlayerPawnsArriveMethod</def>
                        <method>Standing</method>
                    </li>
                    
                    <!-- Player pawns modifiers -->
                    <li Class="ScenPart_ForcedHediff">
                        <def>ForcedHediff</def>
                        <visible>false</visible>
                        <context>PlayerStarter</context>
                        <chance>0.5</chance>
                        <hediff>Malnutrition</hediff>
                        <severityRange>0.2~0.4</severityRange>
                    </li>
                    <li Class="ScenPart_SetNeedLevel">
                    <def>SetNeedLevel</def>
                    <visible>false</visible>
                    <context>PlayerStarter</context>
                    <chance>1.0</chance>
                    <need>Food</need>
                    <levelRange>0~0.1</levelRange>
                    </li>

                    <!-- Player starting things -->
                    <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Silver</thingDef>
                    <count>200</count>
                    </li>
                    <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Pemmican</thingDef>
                    <count>400</count>
                    </li>
                    <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>StoneSoup</thingDef>
                    <count>25</count>
                    </li>
                    <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>WoodenJerky</thingDef>
                    <count>75</count>
                    </li>
                    <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineHerbal</thingDef>
                    <count>20</count>
                    </li>
                    <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>GI_GiantClub</thingDef>
                    </li>
                    <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>GI_Jackstones_granite</thingDef>
                    <!-- <thingDef>GI_Jackstones</thingDef> -->
                    </li>
                    <li Class="ScenPart_StartingAnimal">
                    <def>StartingAnimal</def>
                    <animalKind>HC_WoollyMammoth</animalKind>
                    <count>1</count>
                    <bondToRandomPlayerPawnChance>1</bondToRandomPlayerPawnChance>
                    </li>

                    <!-- Scatter some things near player start -->
                    <li Class="ScenPart_ScatterThingsNearPlayerStart">
                    <def>ScatterThingsNearPlayerStart</def>
                    <thingDef>WoodLog</thingDef>
                    <count>500</count>
                    </li>

                    <!-- Game start dialog -->
                    <li Class="ScenPart_GameStartDialog">
                    <def>GameStartDialog</def>
                    <text>New Giant Tribal.</text>
                    <closeSound>GameStartSting</closeSound>
                    </li>
                </parts>
            </value>
        </match>
    </Operation>
</Patch>