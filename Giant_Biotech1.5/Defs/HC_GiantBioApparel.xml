<?xml version="1.0" encoding="utf-8" ?>
<Defs>


    <ThingDef ParentName="GI_ApparelBase">
        <defName>GI_ChildApp</defName>
        <label>giant baby Clothes</label>
        <description>Sturdy clothing for a giant baby. No matter how strong a giant is, they still need protection in their early years.</description>
        <graphicData>
            <texPath>Giant/Apparel/Clothes/GI_ChildClothes</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.76</drawSize>
        </graphicData>
        <costList>
        </costList>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <costStuffCount>100</costStuffCount>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToMake>5200</WorkToMake>
            <Mass>2</Mass>
            <Flammability>1</Flammability>
            <DeteriorationRate>2</DeteriorationRate>
            <Insulation_Cold>8</Insulation_Cold>

            <StuffEffectMultiplierArmor>0.30</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.35</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.20</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>6</EquipDelay>
        </statBases>
        <equippedStatOffsets>
        </equippedStatOffsets>
        <apparel>
            <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
            <developmentalStageFilter>Child</developmentalStageFilter>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <defaultOutfitTags>
                <li>Worker</li>
                <li>Soldier</li>
            </defaultOutfitTags>
            <wornGraphicPath>Giant/Apparel/Clothes/GI_ChildClothes</wornGraphicPath>   
            <blocksAddedPartWoundGraphics>true</blocksAddedPartWoundGraphics>
            <useWornGraphicMask>true</useWornGraphicMask>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>GiantStory</li>
            </tags>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="GI_ApparelBase">
        <defName>GI_ChildParka</defName>
        <label>giant kid parka</label>
        <description>A parka for giant child, suitable for cold weather. It is made with several thick layers of fabric to ensure good protection.</description>
        <techLevel>Neolithic</techLevel>
        <graphicData>
            <texPath>Giant/Apparel/Clothes/ChildParka/GI_ChildParka</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.76</drawSize>
        </graphicData>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <costStuffCount>180</costStuffCount>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToMake>6800</WorkToMake>
            <Mass>3</Mass>
            <StuffEffectMultiplierArmor>0.5</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1.5</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.00</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
        </statBases>
        <apparel>
            <developmentalStageFilter>Child</developmentalStageFilter>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
            </bodyPartGroups>
            <layers Inherit="False">
                <li>Shell</li>
            </layers>
            <wornGraphicPath>Giant/Apparel/Clothes/ChildParka/GI_ChildParka</wornGraphicPath>
            <blocksAddedPartWoundGraphics>true</blocksAddedPartWoundGraphics>
            <useWornGraphicMask>true</useWornGraphicMask>
            <anyTechLevelCanUseForWarmth>true</anyTechLevelCanUseForWarmth>
            <tags>
                <li>GiantStory</li>
            </tags>
        </apparel>
        <recipeMaker>
            <displayPriority>280</displayPriority>
            <researchPrerequisite>ComplexClothing</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- Giant kid armor -->
    <ThingDef ParentName="GI_HatBase">
        <defName>GI_ChildPotHelmet</defName>
        <label>giant kid helmet</label>
        <description>A helmet made from a wide pot used by small race for cooking, perfectly fitting the head of a giant child.</description>
        <techLevel>Medieval</techLevel> 
        <graphicData>
            <texPath>Giant/Apparel/Clothes/ChildPotHelmet/GI_ChildPotHelmet</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.76</drawSize>
        </graphicData>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>80</costStuffCount>
        <statBases>
            <WorkToMake>3000</WorkToMake>
            <MaxHitPoints>230</MaxHitPoints>
            <Mass>1.6</Mass>
            <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
        <recipeMaker>
            <researchPrerequisite>Smithing</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <recipeUsers Inherit="false">
                <li>ElectricSmithy</li>
                <li>FueledSmithy</li>
            </recipeUsers>
        </recipeMaker>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <developmentalStageFilter>Child</developmentalStageFilter>
            <bodyPartGroups>
                <li>UpperHead</li>
            </bodyPartGroups>
            <!-- <parentTagDef>ApparelHead</parentTagDef> -->
            <wornGraphicPath>Giant/Apparel/Clothes/ChildPotHelmet/GI_ChildPotHelmet</wornGraphicPath>
            <layers>
                <li>Overhead</li>
            </layers>
            <tags>
                <li>GiantStory</li>
            </tags>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
        </apparel>
        <tradeTags>
            <li>Clothing</li>
            <li>Armor</li>
        </tradeTags>
    </ThingDef>


</Defs>