<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Anomaly</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName = "GI_JotunHammerAndShield"]/description</xpath>
					<value>
						<description>A massive warhammer and shield set designed for giants. The spiked head of the warhammer delivers unmatched piercing force. The shield, engraved with a dragon's face, allows the bearer to endure direct hits from bombard boulders.\n\nIt also includes a high-pressure fuel sprayer that emits flame similar to a dragon's breath.</description>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "GI_JotunHammerAndShield"]</xpath>
					<value>
						<comps Inherit="False">
							<li Class="CompProperties_EquippableAbilityReloadable">
								<abilityDef>JotunShieldBurner</abilityDef>
								<maxCharges>10</maxCharges>
								<soundReload>Standard_Reload</soundReload>
								<chargeNoun>burner charge</chargeNoun>
								<ammoDef>Chemfuel</ammoDef>
								<ammoCountPerCharge>100</ammoCountPerCharge>
								<baseReloadTicks>60</baseReloadTicks>
							</li>
							<li Class="CompProperties_Forbiddable"/>
							<li Class="CompProperties_Styleable"/>
							<li Class="CompProperties_Biocodable"/>
							<li>
								<compClass>CompQuality</compClass>
							</li>
							<li Class="CompProperties_Art">
								<nameMaker>NamerArtWeaponGun</nameMaker>
								<descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
								<minQualityForArtistic>Excellent</minQualityForArtistic>
							</li>
						</comps>
					</value>
				</li>
			</operations>
		</match>
	</Operation>


</Patch>